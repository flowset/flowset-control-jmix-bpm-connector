<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://io.jmix.bpmflowui.view.processdefinition/processDefinitionDetail.title"
      messagesGroup="io.jmix.bpmflowui.view.processdefinition"
      extends="io/jmix/bpmflowui/view/processdefinition/process-definition-detail-view.xml">
    <actions>
        <!-- A view-level action: Jmix binds its target to this view, from which it reads the edited entity. -->
        <action id="openInControl" type="ctrcnt_openProcessDefinitionDetailInControl"/>
    </actions>
    <layout>
        <!-- The base descriptor nests its buttons panel this deep; every level must be repeated by id for
             the XML inheritance processor to merge into it instead of appending new containers. -->
        <tabSheet id="tabsheet">
            <tab id="generalTab">
                <vbox id="generalTabVBox">
                    <hbox id="buttonsPanel">
                        <button id="openInControlBtn" action="openInControl"
                                classNames="external-action-in-control"/>
                    </hbox>
                </vbox>
            </tab>
        </tabSheet>
    </layout>
</view>