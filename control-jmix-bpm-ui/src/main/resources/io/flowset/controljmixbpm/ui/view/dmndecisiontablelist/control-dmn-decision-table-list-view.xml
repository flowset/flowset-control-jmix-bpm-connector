<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://io.jmix.bpmflowui.view.dmndecisiontable/decisionTable.title"
      messagesGroup="io.jmix.bpmflowui.view.dmndecisiontable"
      extends="io/jmix/bpmflowui/view/dmndecisiontable/dmn-decision-table-list-view.xml">
    <layout>
        <!-- The base descriptor's buttons hbox has no id, so this one must stay id-less too: the XML
             inheritance processor then falls back to matching the single direct <hbox> child of <layout> and
             merges into it. Adding an id here would create a second, empty hbox instead. -->
        <hbox>
            <button id="openInControlBtn" action="dmnDecisionTablesGrid.openInControl"/>
            <button id="evaluateInControlBtn" action="dmnDecisionTablesGrid.evaluate"
                    classNames="external-action-in-control"/>
        </hbox>
        <dataGrid id="dmnDecisionTablesGrid">
            <actions>
                <!-- Declared on the grid so Jmix binds each action's target to it automatically. -->
                <action id="openInControl"
                        type="ctrint_openDmnDecisionInControl"
                        text="msg://io.flowset.controljmixbpm.ui.view.dmndecisiontablelist/openInControl.text"
                        description="msg://io.flowset.controljmixbpm.ui.view.dmndecisiontablelist/openInControl.title"/>
                <action id="evaluate"
                        type="ctrint_evaluateDmnDecisionInControl"
                        text="msg://io.flowset.controljmixbpm.ui.view.dmndecisiontablelist/evaluate.text"
                        description="msg://io.flowset.controljmixbpm.ui.view.dmndecisiontablelist/evaluate.title"/>
            </actions>
        </dataGrid>
    </layout>
</view>